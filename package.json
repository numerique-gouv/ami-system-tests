{
  "name": "ami-tests-e2e-webdriverio",
  "version": "1.0.0",
  "description": "Tests E2E Appium/WebdriverIO pour l'application AMI (iOS et Android)",
  "private": true,
  "scripts": {
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:webapp": "wdio run wdio.webapp.conf.ts",
    "test:android:staging": "APP_ENV=staging wdio run wdio.android.conf.ts",
    "test:ios:staging": "APP_ENV=staging wdio run wdio.ios.conf.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "appium:install": "npx appium driver install uiautomator2@8.7.0 && npx appium driver install xcuitest@12.12.4",
    "appium:update": "npx appium driver update uiautomator2 && npx appium driver update xcuitest",
    "appium:start": "npx appium --port 4723 --log-level info",
    "open-report": "allure open",
    "report": "rm -rf allure-report && allure generate allure-results && allure open allure-report"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@wdio/allure-reporter": "^10.0.0",
    "@wdio/appium-service": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "allure": "^3.16.0",
    "appium": "^3.7.0",
    "eslint": "^10.9.1",
    "eslint-plugin-wdio": "^10.0.1",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webdriverio": "^10.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "edgedriver@6.3.0": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "appium@3.6.0": true,
    "geckodriver@6.1.1": true
  }
}
