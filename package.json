{
  "name": "ami-tests-e2e-webdriverio",
  "version": "1.0.0",
  "description": "Tests E2E Appium/WebdriverIO pour l'application AMI (iOS et Android)",
  "private": true,
  "scripts": {
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android:staging": "APP_ENV=staging wdio run wdio.android.conf.ts",
    "test:ios:staging": "APP_ENV=staging wdio run wdio.ios.conf.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "appium:install": "npx appium driver install uiautomator2 && npx appium driver install xcuitest",
    "appium:update": "npx appium driver update uiautomator2 && npx appium driver update xcuitest",
    "appium:start": "npx appium --port 4723 --log-level info",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@testing-library/webdriverio": "^3.2.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/types": "^9.30.1",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.2",
    "appium-xcuitest-driver": "^12.1.4",
    "eslint": "^10.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webdriverio": "^9.30.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "appium@3.5.2": true,
    "sharp@0.34.5": true,
    "appium-ios-tuntap@1.1.0": true,
    "edgedriver@6.3.0": true,
    "esbuild@0.28.0": true,
    "fsevents@2.3.3": true,
    "geckodriver@6.1.0": true
  }
}
