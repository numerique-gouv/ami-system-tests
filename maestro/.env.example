# Copier ce fichier en .env et remplir les valeurs manquantes.
# .env est gitignore — ne jamais committer de secrets.

# Chemin vers le SDK Android (répété depuis ../.env : just charge le .env du dossier courant, pas celui du parent)
ANDROID_SDK_ROOT=/Users/<votre-user>/Library/Android/sdk

# URL de l'API AMI backend (sans slash final)
NOTIF_API_URL=https://ami-back-staging.osc-fr1.scalingo.io

# Identifiant du partner AMI (voir ami/partner/models.py)
NOTIF_PARTNER_ID=dinum-ami

# Secret du partner — récupérer depuis Scalingo :
#   https://dashboard.scalingo.com/apps/osc-fr1/ami-back-staging/environment
#   Variable : PARTNERS_DINUM_AMI_SECRET
NOTIF_PARTNER_SECRET=

# Hash FC déterministe du compte sandbox FranceConnect "test" / "123"
# (Angela Claire Louise DUBOIS — SHA256 des données pivot FC)
NOTIF_RECIPIENT_FC_HASH=4abd71ec1f581dce2ea2221cbeac7c973c6aea7bcb835acdfe7d6494f1528060
