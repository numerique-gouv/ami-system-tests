import '../justfile'

export PATH := env_var("PATH") + ":" + env_var("HOME") + "/.maestro/bin" + ":" + android_sdk + "/platform-tools"

# IDs applicatifs (à ajuster si flavor différente)
app_id := "fr.gouv.ami.staging"

# Device Android Maestro — modèle et OS (voir : maestro list-devices)
android_device_model := env_var_or_default("ANDROID_DEVICE_MODEL", "pixel_9")
android_device_os    := env_var_or_default("ANDROID_DEVICE_OS", "android-36")

# ID adb du device pour adb install (emulator-5554 = premier émulateur Maestro)
device := env_var_or_default("DEVICE_ID", "emulator-5554")

_notif_env := "--env NOTIF_API_URL=" + env_var_or_default("NOTIF_API_URL", "") + " --env NOTIF_PARTNER_ID=" + env_var_or_default("NOTIF_PARTNER_ID", "") + " --env NOTIF_PARTNER_SECRET=" + env_var_or_default("NOTIF_PARTNER_SECRET", "") + " --env NOTIF_RECIPIENT_FC_HASH=" + env_var_or_default("NOTIF_RECIPIENT_FC_HASH", "")

_reports_dir := "reports"

# ─── Setup ──────────────────────────────────────────────────────────────────

# Installer Maestro CLI + Android SDK cmdline-tools (requis par maestro start-device)
setup:
    @command -v maestro > /dev/null 2>&1 \
        && echo "✅ Maestro $(maestro --version) déjà installé" \
        || (echo "📦 Installation de Maestro…" && curl -Ls "https://get.maestro.mobile.dev" | bash)
    @test -d "{{ android_sdk }}/cmdline-tools" \
        && echo "✅ Android cmdline-tools déjà installé" \
        || (echo "📦 Installation de Android SDK cmdline-tools…" \
            && {{ android_sdk }}/tools/bin/sdkmanager "cmdline-tools;latest" \
            && echo "✅ Android cmdline-tools installé")

# ─── Tests ──────────────────────────────────────────────────────────────────

# Lancer les tests Android — filtrer par tag(s) optionnel(s)
# Usage : just test-android              → tous les flows
#         just test-android smoke        → tag smoke uniquement
#         just test-android notifications → flows notifications E2E
#         just test-android smoke,auth   → smoke OU auth (séparés par virgule, sans espace)
#        --output "{{ _reports_dir }}/{{platform}}/results-detailed.html" \
[private]
_test platform tags="":
    #!/usr/bin/env bash
    set -euo pipefail
    include_arg=""
    [ -n "{{tags}}" ] && include_arg="--include-tags {{tags}}"
    maestro --device {{ device }} --verbose test \
        --env APP_ID="{{ app_id }}" \
        {{ _notif_env }} \
        $include_arg \
        --format "HTML-DETAILED" \
        --debug-output="." \
        .

test-android tags="":
    maestro start-device --platform=android \
        --device-model={{ android_device_model }} \
        --device-os={{ android_device_os }} \
        --device-locale=fr_FR
    adb -s {{ device }} install -r {{ android_apk }}
    just _test android "{{tags}}"

# Construit un APK staging avant de lancer les tests
test-android-builded tags="": build-android (test-android tags)

test-ios tags="": build-ios
    just _test ios "{{tags}}"

# Lancer les tests sur les deux plateformes (Android puis iOS)
test tags="": (test-android tags) (test-ios tags)

# Test hors-ligne : coupe le réseau, lance le flow offline, rétablit le réseau
test-offline-android:
    maestro start-device --platform=android \
        --device-model={{ android_device_model }} \
        --device-os={{ android_device_os }} \
        --device-locale=fr_FR
    adb -s {{ device }} install -r {{ android_apk }}
    just _driver-start
    adb -s {{ device }} shell svc data disable
    adb -s {{ device }} shell svc wifi disable
    maestro --device {{ device }} test \
        --env APP_ID={{ app_id }} \
        flows/offline/banner.yaml; \
    adb -s {{ device }} shell svc data enable; \
    adb -s {{ device }} shell svc wifi enable

# ─── Outils de développement ────────────────────────────────────────────────

# Ouvrir Maestro Studio (inspecteur visuel interactif)
# Usage : just studio            → Android (défaut)
#         just studio platform=ios → iOS
studio platform="android":
    maestro studio

# Relancer un flow automatiquement à chaque modification (TDD)
# Usage : just watch flows/auth/login.yaml
#         just watch flows/auth/login.yaml platform=ios
watch flow platform="android":
    maestro --device {{ device }} \
        test --watch \
        --env APP_ID={{ app_id }} \
        {{ flow }}

# Exécuter un flow isolé (prérequis : émulateur démarré + app installée)
# Usage : just run flows/auth/login.yaml
#         just run flows/auth/login.yaml platform=ios
run flow platform="android":
    maestro --device {{ device }} \
        --verbose test \
        --env APP_ID={{ app_id }} \
        {{ _notif_env }} \
        {{ flow }}

clean-test-logs:
    rm -rvf .maestro/tests/*
    
    