import '../justfile'

export PATH := env_var("PATH") + ":" + env_var("HOME") + "/.maestro/bin" + ":" + android_sdk + "/platform-tools"

# IDs applicatifs (à ajuster si flavor différente)
android_app_id := "fr.gouv.ami.staging"
ios_app_id     := "fr.gouv.ami.staging"

# Devices cibles (surchargeable via variable d'environnement)
android_device := env_var_or_default("ANDROID_DEVICE_ID", "emulator-5554")
ios_device     := env_var_or_default("IOS_DEVICE_ID",     "")

_device_flag_android := "--device " + android_device
_device_flag_ios     := if ios_device != "" { "--device " + ios_device } else { "" }

# ─── Setup ──────────────────────────────────────────────────────────────────

# Installer Maestro CLI (idempotent)
setup:
    @command -v maestro > /dev/null 2>&1 \
        && echo "✅ Maestro $(maestro --version) déjà installé" \
        || (echo "📦 Installation de Maestro…" && curl -Ls "https://get.maestro.mobile.dev" | bash)

# Installer les APKs Maestro driver et démarrer l'instrumentation gRPC sur port 7001.
# Maestro 2.x embarque les APKs dans maestro-client.jar mais ne les installe pas lui-même.
# Ordre critique : forward → instrument & → nc (le nc passe par le forward).
android-driver-start: android-start
    @adb -s {{android_device}} shell pm list packages 2>/dev/null | grep -q dev.mobile.maestro \
        || (unzip -o -d /tmp "$HOME/.maestro/lib/maestro-client.jar" maestro-app.apk maestro-server.apk \
            && adb -s {{android_device}} install -r -g /tmp/maestro-app.apk \
            && adb -s {{android_device}} install -r -g /tmp/maestro-server.apk \
            && echo "✅ APKs Maestro driver installées")
    adb -s {{android_device}} forward tcp:7001 tcp:7001
    adb -s {{android_device}} shell am instrument -w -r dev.mobile.maestro.test/androidx.test.runner.AndroidJUnitRunner &
    @echo "⏳ Attente du driver Maestro (port 7001)…"
    @until nc -z 127.0.0.1 7001 2>/dev/null; do sleep 1; done
    @echo "✅ Driver Maestro prêt sur {{android_device}}."

# ─── Tests ──────────────────────────────────────────────────────────────────

# Lancer les tests Android — filtrer par tag(s) optionnel(s)
# Usage : just test-android              → tous les flows
#         just test-android smoke        → tag smoke uniquement
#         just test-android notifications → flows notifications E2E
#         just test-android smoke,auth   → smoke OU auth (séparés par virgule, sans espace)
_notif_env := "--env NOTIF_API_URL=" + env_var_or_default("NOTIF_API_URL", "") \
    + " --env NOTIF_PARTNER_ID=" + env_var_or_default("NOTIF_PARTNER_ID", "") \
    + " --env NOTIF_PARTNER_SECRET=" + env_var_or_default("NOTIF_PARTNER_SECRET", "") \
    + " --env NOTIF_RECIPIENT_FC_HASH=" + env_var_or_default("NOTIF_RECIPIENT_FC_HASH", "")

test-android-builded tags="": build-android
    @just test-android {{ tags }}
    
test-android tags="": android-driver-start
    adb -s {{android_device}} install -r {{android_apk}}
    maestro {{_device_flag_android}} test \
        --env APP_ID={{android_app_id}} \
        {{_notif_env}} \
        {{ if tags != "" { "--include-tags " + tags } else { "" } }} \
        --exclude-tags ios-only \
        flows/android/

# Lancer les tests iOS — même logique de filtrage par tags
test-ios tags="": build-ios
    maestro {{_device_flag_ios}} test \
        --env APP_ID={{ios_app_id}} \
        {{_notif_env}} \
        {{ if tags != "" { "--include-tags " + tags } else { "" } }} \
        --exclude-tags android-only \
        flows/ios/

# Lancer les tests sur les deux plateformes (Android puis iOS)
test tags="": (test-android tags) (test-ios tags)

# Test hors-ligne : coupe le réseau, lance le flow offline, rétablit le réseau
test-offline-android:
    adb -s {{android_device}} shell svc data disable
    adb -s {{android_device}} shell svc wifi disable
    maestro {{_device_flag_android}} test \
        --env APP_ID={{android_app_id}} \
        flows/android/06-offline-banner.yaml; \
    adb -s {{android_device}} shell svc data enable; \
    adb -s {{android_device}} shell svc wifi enable

# ─── Outils de développement ────────────────────────────────────────────────

# Ouvrir Maestro Studio (inspecteur visuel interactif)
# Usage : just studio            → Android (défaut)
#         just studio platform=ios → iOS
studio platform="android":
    maestro {{ if platform == "ios" { _device_flag_ios } else { _device_flag_android } }} studio

# Relancer un flow automatiquement à chaque modification (TDD)
# Usage : just watch flows/android/01-launch-review-picker.yaml
#         just watch flows/ios/01-launch-review-picker.yaml platform=ios
watch flow platform="android":
    maestro {{ if platform == "ios" { _device_flag_ios } else { _device_flag_android } }} \
        test --watch \
        --env APP_ID={{ if platform == "ios" { ios_app_id } else { android_app_id } }} \
        {{flow}}

# Exécuter un flow isolé (prérequis : émulateur démarré + driver actif + app installée)
# Usage : just run flows/android/02-franceconnect-displayed.yaml
#         just run flows/ios/01-launch-review-picker.yaml platform=ios
run flow platform="android":
    maestro {{ if platform == "ios" { _device_flag_ios } else { _device_flag_android } }} \
        test \
        --env APP_ID={{ if platform == "ios" { ios_app_id } else { android_app_id } }} \
        {{flow}}
