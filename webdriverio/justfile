import '../justfile'

set dotenv-path := '../.env'

app_id := "fr.gouv.ami.staging"

# ─── Setup ──────────────────────────────────────────────────────────────────

# Afficher les dépendances dépassées (sans modifier package.json)
deps-check:
    npx npm-check-updates

# Mettre à jour package.json vers les dernières versions puis réinstaller
deps-upgrade:
    npx npm-check-updates --upgrade
    @just setup

# Installer les dépendances Node et les drivers Appium
setup:
    @echo "📥 Installation des dépendances…"
    npm install
    @echo "📥 Installation des drivers Appium…"
    npm run appium:install || true
    @echo "✅ Setup terminé. Lance 'just test-android' ou 'just test-ios'."

setup-claude:
    npx skills add klamping/webdriverio-skills

# Générer et ouvrir le rapport Allure du dernier run
report:
    npm run report

# ─── Qualité ────────────────────────────────────────────────────────────────

# Vérifications statiques : lint + typecheck (sans lancer les tests)
build-test:
    npm run lint
    npm run typecheck

# ─── Tests ──────────────────────────────────────────────────────────────────
# Deux filtres optionnels combinables, chacun acceptant une regex :
#   tag="<regex>"   → filtre describe/it Mocha (--mochaOpts.grep, regex JS)
#   file="<regex>"  → filtre les chemins de spec via `grep -E` (regex POSIX étendue)
#                     contre `src/tests/**/*.test.ts`
#
# Exemples :
#   just test-android                                       → tous les tests
#   just test-android tag="Notifications"                   → filtre Mocha
#   just test-android file="notifications"                  → filtre fichier
#   just test-android file="administration_partenaire/"     → tout un sous-répertoire
#   just test-android tag="vanilla" file="notif|home"       → les deux combinés

# Lancer les tests E2E Android — démarre l'émulateur, build, lance les tests
test-android tag="" file="": android-start
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🤖 Tests E2E Android…"
    just _run-tests android '{{tag}}' '{{file}}'

# Lancer les tests E2E iOS — démarre le simulateur, build, reset FC, lance les tests
test-ios tag="" file="": ios-start
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🍎 Tests E2E iOS…"
    just _ios-reset-fc-session
    just _run-tests ios '{{tag}}' '{{file}}'

# Tests Android sans rebuild — démarre l'émulateur si nécessaire, puis lance directement
test-android-builded tag="" file="": build-android android-start
    #!/usr/bin/env bash
    set -euo pipefail
    just _run-tests android '{{tag}}' '{{file}}'

# Tests iOS sans rebuild — reset=true par défaut ; reset="" pour le désactiver (debug)
test-ios-builded tag="" file="" reset="true": build-ios ios-start
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "{{reset}}" ]; then
        just _ios-reset-fc-session
    fi
    just _run-tests ios '{{tag}}' '{{file}}'

# Compose les arguments WDIO selon tag et file et lance la suite.
# - file (regex POSIX étendue) sélectionne des `--spec` parmi src/tests/**/*.test.ts
# - tag (regex JS) est passé tel quel à --mochaOpts.grep
# Échoue explicitement si file ne matche aucun fichier.
[private]
_run-tests platform tag file:
    #!/usr/bin/env bash
    set -euo pipefail
    ARGS=()
    if [ -n '{{file}}' ]; then
        MATCHES=$(find src/tests -type f -name '*.test.ts' | grep -E '{{file}}' || true)
        if [ -z "$MATCHES" ]; then
            echo "❌ Aucun fichier ne matche file=« {{file}} »." >&2
            exit 1
        fi
        echo "📂 Fichiers ciblés :"
        while IFS= read -r f; do
            echo "   - $f"
            ARGS+=(--spec "$f")
        done <<< "$MATCHES"
    fi
    if [ -n '{{tag}}' ]; then
        echo "🔎 Filtre Mocha tag=« {{tag}} »"
        ARGS+=(--mochaOpts.grep '{{tag}}')
    fi
    if [ ${#ARGS[@]} -gt 0 ]; then
        npm run test:{{platform}} -- "${ARGS[@]}"
    else
        npm run test:{{platform}}
    fi

# ─── Inspection ─────────────────────────────────────────────────────────────

# Lister les éléments interactifs de la WebView courante (sans réinitialiser l'app)
# Usage : just inspect-android             → inspecte l'écran courant
#         just inspect-android /notifications → navigue vers /#/notifications puis inspecte
inspect-android hash="":
    #!/usr/bin/env bash
    set -euo pipefail
    ADB="{{ android_sdk }}/platform-tools/adb"
    export ANDROID_SDK_ROOT="{{ android_sdk }}"
    export ANDROID_HOME="{{ android_sdk }}"
    # Android 16 (API 36) : un IAccessibilityServiceClient résiduel (Maestro ou run précédent)
    # bloque la connexion UiAutomation avec "already registered" / "id=-1".
    # Force-stop tous les packages susceptibles d'avoir laissé un client enregistré.
    "$ADB" shell am force-stop io.appium.uiautomator2.server.test 2>/dev/null || true
    "$ADB" shell am force-stop io.appium.uiautomator2.server 2>/dev/null || true
    "$ADB" shell am force-stop dev.mobile.maestro 2>/dev/null || true
    "$ADB" shell am force-stop dev.mobile.maestro.test 2>/dev/null || true
    # Réveiller l'écran et s'assurer qu'il est déverrouillé
    "$ADB" shell input keyevent 82
    "$ADB" shell input keyevent 4
    sleep 1
    echo "🔍 Démarrage Appium sur le port 4723…"
    # --allow-insecure active le téléchargement automatique de Chromedriver (requis WebView)
    npm run appium:start -- --port 4723 --allow-insecure uiautomator2:chromedriver_autodownload &
    APPIUM_PID=$!
    trap "kill $APPIUM_PID 2>/dev/null; exit" INT TERM EXIT
    sleep 5
    echo "🔍 Inspection de la WebView en cours…"
    npx ts-node --project tsconfig.json src/scripts/inspect-android-webview.ts "{{hash}}"
    kill $APPIUM_PID 2>/dev/null || true

# Inspecter la page de détail d'une notification (navigue vers la liste, clique le 1er item)
inspect-android-notification-detail:
    #!/usr/bin/env bash
    set -euo pipefail
    ADB="{{ android_sdk }}/platform-tools/adb"
    export ANDROID_SDK_ROOT="{{ android_sdk }}"
    export ANDROID_HOME="{{ android_sdk }}"
    "$ADB" shell am force-stop io.appium.uiautomator2.server.test 2>/dev/null || true
    "$ADB" shell am force-stop io.appium.uiautomator2.server 2>/dev/null || true
    "$ADB" shell am force-stop dev.mobile.maestro 2>/dev/null || true
    "$ADB" shell am force-stop dev.mobile.maestro.test 2>/dev/null || true
    "$ADB" shell input keyevent 82
    npm run appium:start -- --port 4723 --allow-insecure uiautomator2:chromedriver_autodownload &
    APPIUM_PID=$!
    trap "kill $APPIUM_PID 2>/dev/null; exit" INT TERM EXIT
    sleep 5
    npx ts-node --project tsconfig.json src/scripts/inspect-notification-detail.ts
    kill $APPIUM_PID 2>/dev/null || true

# ─── Reset iOS ──────────────────────────────────────────────────────────────

# Réinitialise complètement le conteneur de données de l'app AMI staging.
# Un effacement partiel (WebKit/cookies seuls) laisse l'app dans un état incohérent
# où la WKWebView se reconnecte sans afficher la mire FC. On vide tout le conteneur data.
[private]
_ios-reset-fc-session:
    #!/usr/bin/env bash
    set -euo pipefail
    BOOTED_UDID=$(xcrun simctl list devices booted \
        | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' \
        | head -1)
    if [ -z "$BOOTED_UDID" ]; then
        echo "⚠️  Aucun simulateur iOS démarré — _ios-reset-fc-session ignoré."
        exit 0
    fi
    # Réinitialise la permission notifications
    xcrun simctl privacy "$BOOTED_UDID" reset notifications {{ app_id }} 2>/dev/null || true
    # Efface les cookies SFSafariViewController (session OIDC FC partagée avec Safari)
    xcrun simctl spawn "$BOOTED_UDID" defaults delete com.apple.SafariViewService 2>/dev/null || true
    xcrun simctl spawn "$BOOTED_UDID" rm -rf /Library/Caches/com.apple.SafariViewService 2>/dev/null || true
    xcrun simctl spawn "$BOOTED_UDID" rm -f /var/mobile/Library/Cookies/com.apple.SafariViewService.binarycookies 2>/dev/null || true
    # Vide l'intégralité du conteneur data de l'app (équivalent "effacer les données" dans Réglages)
    APP_CONTAINER=$(xcrun simctl get_app_container "$BOOTED_UDID" {{ app_id }} data 2>/dev/null || true)
    if [ -n "$APP_CONTAINER" ]; then
        rm -rf "${APP_CONTAINER:?}/"* 2>/dev/null || true
    fi
    echo "✅ Conteneur data AMI staging vidé."
