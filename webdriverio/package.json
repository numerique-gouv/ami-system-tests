{
  "name": "ami-tests-e2e-webdriverio",
  "version": "1.0.0",
  "description": "Tests E2E Appium/WebdriverIO pour l'application AMI (iOS et Android)",
  "private": true,
  "scripts": {
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:android:staging": "APP_ENV=staging wdio run wdio.android.conf.ts",
    "test:ios:staging": "APP_ENV=staging wdio run wdio.ios.conf.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "appium:install": "appium driver install uiautomator2 && appium driver install xcuitest",
    "appium:start": "appium --port 4723 --log-level info"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/types": "^9.27.1",
    "appium": "^3.4.2",
    "appium-uiautomator2-driver": "^7.4.0",
    "appium-xcuitest-driver": "^11.4.2",
    "eslint": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webdriverio": "^9.27.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
