{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.schema.json",
  "title": "Modèle d'application (face A)",
  "description": "Surface applicative d'une app AMI. Voir ../spec.md §3-4.",
  "type": "object",
  "required": [
    "app",
    "title",
    "kind",
    "targets",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "app": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "spa",
        "native",
        "external",
        "api",
        "admin-web"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "description": "Chemin de document, de dépôt frère ou d'URL"
          },
          "observed-on": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "string"
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "reached-by"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "reached-by": {
            "type": "string",
            "description": "Comment un test atteint cet état (nom de fonction ou de Page Object)"
          },
          "options": {
            "type": "object"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "description": "Helper de test qui l'appelle"
          },
          "feeds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/obsRef"
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "observed-on": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "when"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "integer"
                },
                "when": {
                  "type": "string"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "shown-on",
          "actions"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "actions": {
            "$ref": "#/$defs/actions"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "shown-on": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "screens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/screen"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "target": {
      "enum": [
        "webapp",
        "android",
        "ios",
        "http",
        "partner-web"
      ]
    },
    "evidence": {
      "enum": [
        "live",
        "code",
        "backlog",
        "unconfirmed"
      ]
    },
    "localOrFull": {
      "type": "string",
      "pattern": "^([a-z0-9-]+:)?[a-z0-9%$~@#.-]+$"
    },
    "screenRef": {
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*:)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "obsRef": {
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*:)?[a-z0-9]+(-[a-z0-9]+)*@[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "opRef": {
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*:)?~[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "screen": {
      "type": "object",
      "required": [
        "title",
        "kind",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "page",
            "tab",
            "dialog",
            "native",
            "external",
            "error"
          ]
        },
        "route": {
          "type": "string",
          "description": "Route de la SPA ; modèle avec {param}"
        },
        "route-shared-with": {
          "$ref": "#/$defs/id",
          "description": "Pour kind=tab : l'écran parent qui porte la même route"
        },
        "entry": {
          "type": "boolean",
          "description": "Point d'entrée explicite du graphe (C4)"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "page-object": {
          "type": "string"
        },
        "identity": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string"
            },
            "route": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observables": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/observable"
          }
        },
        "actions": {
          "$ref": "#/$defs/actions"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed-on": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tab"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "route-shared-with"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "live"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "required": [
              "observed-on"
            ]
          }
        }
      ]
    },
    "observable": {
      "type": "object",
      "required": [
        "label",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "list",
            "field",
            "toggle",
            "toggles",
            "badge",
            "link"
          ]
        },
        "source": {
          "enum": [
            "static",
            "user-data",
            "operation",
            "derived"
          ]
        },
        "fed-by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opRef"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "action": {
      "type": "object",
      "required": [
        "kind",
        "label",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "read",
            "navigate",
            "mutate",
            "switch"
          ]
        },
        "label": {
          "type": "string"
        },
        "via": {
          "enum": [
            "button",
            "tab",
            "route",
            "back",
            "link"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "observed-on": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string"
        },
        "coverage": {
          "enum": [
            "required",
            "excluded"
          ],
          "default": "required"
        },
        "reason": {
          "type": "string"
        },
        "risk": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "shared-data",
              "destructive",
              "permission-prompt",
              "third-party",
              "legal"
            ]
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obsRef"
          }
        },
        "params": {
          "type": "object",
          "properties": {
            "per-value": {
              "type": "boolean"
            }
          },
          "additionalProperties": {
            "type": [
              "array",
              "boolean"
            ]
          }
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "note": {
          "type": "string"
        },
        "observes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/localOrFull"
          }
        },
        "to": {
          "$ref": "#/$defs/screenRef"
        },
        "transport": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "http": {
              "enum": [
                "2xx",
                "3xx",
                "any-success"
              ]
            },
            "native": {
              "type": "string"
            }
          }
        },
        "leaves-app": {
          "type": "boolean"
        },
        "conditional": {
          "type": "boolean"
        },
        "field": {
          "$ref": "#/$defs/localOrFull"
        },
        "restore": {
          "enum": [
            "action",
            "api",
            "logout",
            "none"
          ]
        },
        "toggle": {
          "$ref": "#/$defs/localOrFull"
        },
        "initial": {
          "enum": [
            "enabled",
            "disabled",
            "unknown"
          ]
        },
        "gates": {
          "type": "object",
          "required": [
            "capability",
            "absent-probe",
            "present-probe"
          ],
          "additionalProperties": false,
          "properties": {
            "capability": {
              "type": "string"
            },
            "absent-probe": {
              "$ref": "#/$defs/localOrFull"
            },
            "present-probe": {
              "$ref": "#/$defs/localOrFull"
            },
            "feed": {
              "$ref": "#/$defs/opRef"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "observes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "navigate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mutate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "field",
              "restore"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "toggle",
              "gates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "excluded"
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "restore": {
                "const": "none"
              }
            },
            "required": [
              "restore"
            ]
          },
          "then": {
            "required": [
              "coverage"
            ],
            "properties": {
              "coverage": {
                "const": "excluded"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "live"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "required": [
              "observed-on"
            ]
          }
        }
      ]
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "api"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "operations"
        ]
      },
      "else": {
        "required": [
          "screens"
        ]
      }
    }
  ]
}
