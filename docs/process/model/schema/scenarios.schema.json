{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenarios.schema.json",
  "title": "Modèle de scénarios (face B)",
  "description": "Description des tests de src/tests/** comme traces sur le modèle d'application. Voir ../spec.md §5.",
  "type": "object",
  "required": [
    "suite",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "suite": {
      "type": "object",
      "required": [
        "title",
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "root": {
          "type": "string",
          "description": "Répertoire des tests décrits, relatif au dépôt"
        },
        "described-on": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "target": {
      "enum": [
        "webapp",
        "android",
        "ios",
        "http",
        "partner-web"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[%$~]?[a-z0-9]+(-[a-z0-9]+)*([#@][a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "screenRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "obsRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*@[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "actionRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:%?[a-z0-9]+(-[a-z0-9]+)*#[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "stateRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:\\$[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "opRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:~[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "step": {
      "enum": [
        "observe",
        "trigger",
        "arrive",
        "http-ok",
        "read-origin",
        "mutate",
        "read-mutation",
        "restore",
        "disable",
        "absent",
        "enable",
        "present"
      ]
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "source",
        "status",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "source": {
          "type": "object",
          "required": [
            "file",
            "describe",
            "it"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "describe": {
              "type": "string"
            },
            "it": {
              "type": "string",
              "description": "Titre exact, ou gabarit si parametrized"
            },
            "parametrized": {
              "type": "boolean"
            }
          }
        },
        "status": {
          "enum": [
            "active",
            "skipped",
            "backlog"
          ]
        },
        "reason": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epic": {
              "type": "string"
            },
            "feature": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "blocker",
                "critical",
                "normal",
                "minor",
                "trivial"
              ]
            },
            "other": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateRef"
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceItem"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cleanup"
          }
        },
        "intends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "unmodeled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "skipped",
                  "backlog"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "trace"
            ],
            "properties": {
              "trace": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "traceItem": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "visit"
          ],
          "additionalProperties": false,
          "properties": {
            "visit": {
              "$ref": "#/$defs/screenRef"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "observe"
          ],
          "additionalProperties": false,
          "properties": {
            "observe": {
              "$ref": "#/$defs/obsRef"
            },
            "expect": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "do"
          ],
          "additionalProperties": false,
          "properties": {
            "do": {
              "$ref": "#/$defs/actionRef"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "with": {
              "type": "object"
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "call"
          ],
          "additionalProperties": false,
          "properties": {
            "call": {
              "$ref": "#/$defs/opRef"
            },
            "with": {
              "type": "object"
            },
            "note": {
              "type": "string"
            }
          }
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "required": [
        "restores",
        "by",
        "assured"
      ],
      "additionalProperties": false,
      "properties": {
        "restores": {
          "type": "string",
          "description": "Référence @observable ou #action de la donnée restaurée"
        },
        "by": {
          "enum": [
            "inline",
            "after-hook",
            "logout",
            "none"
          ]
        },
        "assured": {
          "enum": [
            "asserted",
            "best-effort"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  }
}
