# Gabarit committé dans git — ne jamais y renseigner de vraies valeurs/secrets.
# Copier ce fichier en .env.local (gitignoré, cf. .gitignore) et y remplir les valeurs manquantes :
# c'est .env.local que le justfile (dotenv-path) et wdio.base.conf.ts chargent réellement.

# Chemin vers le SDK Android (répété depuis ../.env : just charge le .env du dossier courant, pas celui du parent)
# ANDROID_SDK_ROOT=/Users/<votre-user>/Library/Android/sdk
ANDROID_SDK_ROOT=

# Environnement Scalingo cible — fragment contenu dans le titre ou le numéro de PR du picker.
# Exemples : "Staging", "1234" (numéro de PR), "feature-mon-ticket"
# Dans .env.local, surcharger pour cibler une review app : AMI_ENV=1234
# L'URL backend est résolue automatiquement via GET /dev-utils/review-apps sur staging.
AMI_ENV=

# Code d'accès demandé par un popup natif (window.prompt) au chargement de la webapp
# de staging — gate côté SPA, distinct du Basic Auth partenaire ci-dessous.
WEB_APP_ACCESS_KEYS=

# Identifiant du partner AMI (voir ami/partner/models.py)
NOTIF_PARTNER_ID=

# Secret du partner — récupérer depuis Scalingo :
#   https://dashboard.scalingo.com/apps/osc-fr1/ami-back-staging/environment
#   Variable : PARTNERS_DINUM_AMI_SECRET
NOTIF_PARTNER_SECRET=
