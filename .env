# Gabarit committé dans git — ne jamais y renseigner de vraies valeurs/secrets.
#
# Fichier d'environnement :
#   - Chaque poste copie ce fichier en `.env.local` (gitignoré) et y remplit les valeurs : `just` le charge par défaut (réglage
#     `set dotenv-path` du justfile) et wdio.base.conf.ts le charge aussi quand les commandes sont lancées sans `just`.
#   - Un autre fichier pour une fois : `just -E .env.local.preprod test-ios --suite mobile_short` (option native `-E` /
#     `--dotenv-path`). Convention de nommage : `.env.local.<cible>` (`.env.local.staging`, `.env.local.preprod`), tous gitignorés.
#     Un fichier choisi par `-E` doit être COMPLET : `.env.local` n'est alors PAS relu pour combler ses manques (pas de mélange
#     staging/préprod).
#   - Surcharge ponctuelle d'une variable : `AMI_ENV=preprod ANDROID_APP_PATH=… just test-android --suite mobile_short` (une variable
#     déjà définie dans le shell l'emporte sur les fichiers).
#   - Détail : README.md, section « Prérequis ».

# Chemin vers le SDK Android (répété depuis ../.env : just charge le .env du dossier courant, pas celui du parent)
# ANDROID_SDK_ROOT=/Users/<votre-user>/Library/Android/sdk
ANDROID_SDK_ROOT=

# Environnement Scalingo cible — fragment contenu dans le titre ou le numéro de PR du picker.
# Exemples : "Staging", "Preprod" (préproduction), "1234" (numéro de PR), "feature-mon-ticket"
# Dans .env.local, surcharger pour cibler une review app : AMI_ENV=1234
# Preprod : https://preprod.ami.beta.numerique.gouv.fr (SPA + API événements/consentement).
# Facultatif : sans valeur, l'environnement par défaut est Staging.
# L'URL backend est résolue automatiquement via GET /dev-utils/review-apps sur staging.
AMI_ENV=

# Apps mobiles à tester : SOURCE UNIQUE du chemin (aucun chemin n'est calculé ailleurs) ; variable absente ou chemin inexistant →
# erreur qui nomme la variable (src/driver/capabilities.ts). AMI_ENV doit correspondre à l'app visée (identifiants staging/préprod).
# Android — APK Gradle, chemin relatif à la racine de ce projet (depuis ../ami-app-android : ./gradlew assembleStagingDebug ; préprod : assemblePreprodDebug et
# app/build/outputs/apk/preprod/debug/app-preprod-debug.apk) :
ANDROID_APP_PATH=../ami-app-android/app/build/outputs/apk/staging/debug/app-staging-debug.apk
# iOS — .app du build Xcode (simulateur), dans DerivedData ; le nom du dossier AMI-xcodegen-<suffixe> est propre à chaque poste, à
# compléter, et à décommenter (ls ~/Library/Developer/Xcode/DerivedData). Préprod : AMI-Preproduction.app.
# IOS_APP_PATH=~/Library/Developer/Xcode/DerivedData/AMI-xcodegen-<suffixe>/Build/Products/Debug-iphonesimulator/AMI-Staging.app

# Ports locaux (facultatifs ; utiles pour lancer un second appareil en parallèle sans conflit avec les valeurs par défaut) :
# ANDROID_APPIUM_PORT=4723        # serveur Appium Android
# IOS_APPIUM_PORT=4724            # serveur Appium iOS
# ANDROID_SYSTEM_PORT=8200        # serveur UiAutomator2
# ANDROID_CHROMEDRIVER_PORT=9515  # Chromedriver de la WebView
# IOS_WDA_PORT=8100               # WebDriverAgent
# Appareil visé (facultatif, aucune option `--device` : les recettes just n'en prennent pas ; surcharge ponctuelle :
# `ANDROID_UDID=emulator-5560 just test-android …`). Aucune recette ne démarre ni n'arrête d'appareil.
# Android : ANDROID_UDID = numéro de série adb (`adb devices`), ANDROID_DEVICE_NAME = nom d'appareil/AVD ; sans eux, le premier appareil connecté.
#   ANDROID_AVD = nom d'AVD (`emulator -list-avds`) : Appium le lance s'il ne tourne pas (il s'arrête avec le run) ; ANDROID_AVD_ARGS =
#   options d'`emulator` (ex. `-port 5560 -no-snapshot-save`, avec ANDROID_UDID=emulator-5560 pour un second émulateur isolé).
# iOS : IOS_UDID = identifiant du simulateur (`xcrun simctl list devices`) ; XCUITest le démarre s'il est arrêté. IOS_DEVICE_NAME = son nom.
# ANDROID_UDID=
# ANDROID_DEVICE_NAME=
# ANDROID_AVD=
# ANDROID_AVD_ARGS=
# IOS_UDID=
# IOS_DEVICE_NAME=

# Code d'accès demandé par un popup natif (window.prompt) au chargement de la webapp
# de staging — gate côté SPA, distinct du Basic Auth partenaire ci-dessous.
WEB_APP_ACCESS_KEYS=

# Identifiant du partner AMI (voir ami/partner/models.py)
NOTIF_PARTNER_ID=

# Secret du partner — récupérer depuis Scalingo :
#   https://dashboard.scalingo.com/apps/osc-fr1/ami-back-staging/environment
#   Variable : PARTNERS_DINUM_AMI_SECRET
NOTIF_PARTNER_SECRET=

# Autre partenaire (consentement ACTIVÉ côté backend), requis par les scénarios S5, S5.2 et S6.3 (consentement.md) : sans lui ils sont
# SKIPPÉS. Nommage : NOTIF_PARTNER_<SLUG>_ID / _SECRET, <SLUG> = slug du partenaire en majuscules (`dinum-dn` → DINUM_DN).
# Secret : variable PARTNERS_DINUM_DN_SECRET de l'application Scalingo du backend. (Autres : DINUM_RDVSP ; `psl` n'a PAS le consentement activé.)
NOTIF_PARTNER_DINUM_DN_ID=
NOTIF_PARTNER_DINUM_DN_SECRET=
